{
  "name": "@kaggle-lint/ui-components",
  "version": "2.0.0",
  "description": "React UI components for Kaggle Python Linter",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run copy-css",
    "copy-css": "copyfiles -u 1 \"src/**/*.css\" dist",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@kaggle-lint/core": "*"
  },
  "keywords": [
    "linter",
    "react",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "copyfiles": "^2.4.1"
  }
}
