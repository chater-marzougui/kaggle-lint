{
  "name": "@kaggle-lint/extension",
  "version": "1.0.2",
  "description": "Chrome extension for Kaggle Linter",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch",
    "test": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "0.15.21",
    "@kaggle-lint/core": "*",
    "@kaggle-lint/ui-components": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "chrome-extension",
    "linter",
    "kaggle"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.1.33",
    "@types/jest": "^29.5.14",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
